# Copy this file as .env and fill the values you have.
SECRET_KEY=change-this-secret
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# Razorpay: Test keys work for development; Live keys enable real payments after your account is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional direct UPI QR fallback (not auto-verified)
UPI_ID=

# Optional real SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional WhatsApp via Twilio
TWILIO_WHATSAPP_FROM=

# Demo payment mode (1 = enabled, no real money charged)
DEMO_PAYMENT=1
# Optional: set your computer LAN IP, e.g. 192.168.1.5:8000, so a phone can open the QR link.
# DEMO_QR_HOST=192.168.1.5:8000
